rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidTrialCreate() {
      return request.resource.data.plan == 'trial'
        && request.resource.data.subscriptionStatus == 'active'
        && request.resource.data.paymentId == null
        && (!('premiumGranted' in request.resource.data)
            || request.resource.data.premiumGranted == false);
    }

    function subscriptionFieldsUnchanged() {
      let protected = [
        'plan',
        'subscriptionStatus',
        'trialStart',
        'trialEnd',
        'expiresAt',
        'gracePeriodEnd',
        'paymentId',
        'premiumGranted',
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protected);
    }

    function isPremiumGrantedBackfill() {
      return !('premiumGranted' in resource.data)
        && request.resource.data.premiumGranted == false
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['premiumGranted', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidTrialCreate();
      allow update: if isOwner(userId) && (subscriptionFieldsUnchanged() || isPremiumGrantedBackfill());

      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /notifications/{userId}/items/{itemId} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
